{
  "name": "aiview",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json",
    "test": "node --import ./tests/no-browser.preload.ts --test \"tests/**/*.test.ts\"",
    "test:app": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-toggle-group": "1.1.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.33.0",
    "mermaid": "11.17.0",
    "parse5": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "3.6.0"
  }
}
